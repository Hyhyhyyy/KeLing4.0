FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --ignore-scripts
COPY apps/web apps/web
COPY packages/shared packages/shared
COPY assets/stellar assets/stellar
COPY scripts/build-shared.cjs scripts/build-shared.cjs
COPY scripts/sync-stellar-assets.cjs scripts/sync-stellar-assets.cjs
COPY scripts/lib/stellar-assets.cjs scripts/lib/stellar-assets.cjs
ENV VITE_API_BASE_URL=/api
RUN npm run build:web

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
EXPOSE 80 443 443/udp
