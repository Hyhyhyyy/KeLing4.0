FROM node:24-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --ignore-scripts
COPY apps/server apps/server
COPY packages/shared packages/shared
COPY scripts/build-shared.cjs scripts/build-shared.cjs
RUN npm run build:shared
RUN npm run prisma:generate --workspace=keling-server -- --schema=prisma/schema.postgresql.prisma
RUN npm run build:server

FROM node:24-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Prisma CLI is intentionally retained for the one-shot migration service.
COPY --from=build --chown=node:node /app /app
ENV NODE_ENV=production PORT=3001
USER node
WORKDIR /app/apps/server
EXPOSE 3001
CMD ["node", "dist/index.js"]
