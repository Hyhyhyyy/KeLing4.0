# Copy to ignored .env.vercel.local. Use a NEW Neon database/branch for preview.
# Keep production and preview databases and JWT secrets separate.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST-pooler.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require
JWT_SECRET=
# Optional custom domains, comma-separated exact origins; no wildcard.
CORS_ORIGINS=
# Optional model configuration: see apps/server/.env.example. Never use VITE_ for secrets.
