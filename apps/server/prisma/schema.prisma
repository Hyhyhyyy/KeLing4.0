// KeLing 数据库模型定义
// 对应 Android Models.kt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 用户相关 ====================
model MaterialVersion {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  id String @id @default(uuid())
  userId String
  courseId String
  materialId String
  version Int
  title String
  format String
  content String
  contentHash String
  parseStatus String @default("READY")
  parserVersion String
  sourceName String
  supersedesId String?
  createdAt DateTime @default(now())
  deletedAt DateTime?
  spans SourceSpan[]
  @@unique([userId, materialId, version])
  @@index([userId, courseId, createdAt])
}
model SourceSpan {
  id String @id @default(uuid())
  materialVersionId String
  ordinal Int
  startUtf16 Int
  endUtf16 Int
  page Int?
  paragraphIndex Int?
  heading String @default("")
  textHash String
  materialVersion MaterialVersion @relation(fields: [materialVersionId], references: [id], onDelete: Cascade)
  @@unique([materialVersionId, ordinal])
}
model ExpeditionProgress {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  id String @id @default(uuid())
  userId String
  courseId String
  chapterId String
  revision Int @default(0)
  contentVersion String
  state String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, courseId, chapterId])
}
model QuestRun {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  id String @id @default(uuid())
  userId String
  courseId String
  progressId String
  taskId String?
  revision Int @default(0)
  status String
  state String
  writerDeviceId String @default("")
  leaseEpoch Int @default(0)
  leaseTokenHash String @default("")
  leaseExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, courseId, updatedAt])
}
model ExpeditionOperation {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  id String @id @default(uuid())
  userId String
  opId String
  scope String
  scopeId String
  requestHash String
  payload String
  receipt String
  createdAt DateTime @default(now())
  @@unique([userId, opId])
  @@index([userId, scope, scopeId, createdAt])
}
model RewardGrant {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  id String @id @default(uuid())
  userId String
  stableKey String
  kind String
  exp Int
  crystals Int
  ruleVersion String
  reason String
  sourceId String
  createdAt DateTime @default(now())
  @@unique([userId, stableKey])
}
model ExpeditionAccount {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @id
  revision Int @default(0)
  legacySnapshot String
  world String
  quotaDay String @default("")
  cycleCount Int @default(0)
  selfReportCount Int @default(0)
  crystalsGranted Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== 用户相关 ====================

model User {
  materialVersions MaterialVersion[]
  expeditionProgress ExpeditionProgress[]
  questRuns QuestRun[]
  expeditionOperations ExpeditionOperation[]
  rewardGrants RewardGrant[]
  expeditionAccount ExpeditionAccount?
  id                String   @id @default(uuid())
  name              String   @default("星际园丁")
  email             String   @unique
  passwordHash      String
  level             Int      @default(1)
  exp               Int      @default(0)
  energy            Int      @default(100)
  crystals          Int      @default(10)
  streakDays        Int      @default(0)
  totalStudyMinutes Int      @default(0)
  streakProtectionCards Int  @default(0)
  lastCheckInDate   String?
  avatarUrl         String?
  bio               String   @default("")
  weeklyStudyGoal   Int      @default(300)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // 关联
  courses           Course[]
  tasks             Task[]
  notes             Note[]
  achievements      UserAchievement[]
  checkInRecords    CheckInRecord[]
  studyRecords      StudyRecord[]
  chatHistory       ChatHistory[]

  @@map("users")
}

// ==================== 课程与知识 ====================

model Course {
  id                String   @id @default(uuid())
  userId            String
  name              String
  code              String
  teacher           String
  schedule          String   @default("[]")  // JSON: ScheduleSlot[]
  location          String   @default("")
  themeColor        String   @default("#E8A87C")
  masteryLevel      Float    @default(0)
  plantStage        Int      @default(0)
  planetStyleIndex  Int      @default(-1)
  lastStudiedAt     DateTime?
  totalStudyMinutes Int      @default(0)
  isArchived        Boolean  @default(false)
  semester          String?
  credit            Int      @default(0)
  examDate          DateTime?
  courseImageUrl    String?
  studySessionCount Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // 关联
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeNodes    KnowledgeNode[]

  @@map("courses")
}

model KnowledgeNode {
  id            String   @id @default(uuid())
  courseId      String
  name          String
  description   String   @default("")
  parentIds     String   @default("[]")  // JSON: string[]
  childIds      String   @default("[]")  // JSON: string[]
  difficulty    Int      @default(3)
  masteryLevel  Float    @default(0)
  positionX     Float    @default(0.5)
  positionY     Float    @default(0.5)
  isUnlocked    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 关联
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("knowledge_nodes")
}

// ==================== 任务系统 ====================

model Task {
  id               String    @id @default(uuid())
  userId           String
  title            String
  description      String
  type             String    // TaskType enum
  courseId         String?
  knowledgeNodeIds String    @default("[]")  // JSON: string[]
  status           String    @default("PENDING")  // TaskStatus enum
  priority         Int       @default(3)
  estimatedMinutes Int       @default(25)
  actualMinutes    Int?
  rewardsEnergy    Int       @default(10)
  rewardsCrystals  Int       @default(5)
  rewardsExp       Int       @default(20)
  scheduledAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // 关联
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

// ==================== 笔记系统 ====================

model Note {
  id              String   @id @default(uuid())
  userId          String
  title           String
  content         String
  sourceType      String   // NoteSource enum
  aiExplanation   String?
  relatedNodeIds  String   @default("[]")  // JSON: string[]
  tags            String   @default("[]")  // JSON: string[]
  reviewCount     Int      @default(0)
  lastReviewedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关联
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes")
}

// ==================== 成就系统 ====================

model Achievement {
  id              String   @id
  name            String
  description     String
  icon            String
  category        String   // AchievementCategory enum
  requirement     String   @default("")
  rewardEnergy    Int      @default(50)
  rewardCrystals  Int      @default(30)
  maxProgress     Int      @default(1)

  @@map("achievements")
}

model UserAchievement {
  id           String    @id @default(uuid())
  userId       String
  achievementId String
  isUnlocked   Boolean   @default(false)
  progress     Int       @default(0)
  unlockedAt   DateTime?
  createdAt    DateTime  @default(now())

  // 关联
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ==================== 签到系统 ====================

model CheckInRecord {
  id             String   @id @default(uuid())
  userId         String
  date           String   // YYYYMMDD format
  rewardReceived Boolean  @default(false)
  createdAt      DateTime @default(now())

  // 关联
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("check_in_records")
}

// ==================== 学习记录 ====================

model StudyRecord {
  id              String   @id @default(uuid())
  userId          String
  courseId        String?
  taskId          String?
  type            String   // StudyType enum
  durationMinutes Int
  notes           String   @default("")
  createdAt       DateTime @default(now())

  // 关联
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_records")
}

// ==================== 对话历史 ====================

model ChatHistory {
  id         String   @id @default(uuid())
  userId     String
  sessionId  String
  role       String   // user / assistant
  content    String
  toolUsed   String?
  toolResult String?
  createdAt  DateTime @default(now())

  // 关联
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_history")
}
model AgentRun {
  id String @id @default(uuid())
  userId String
  courseId String
  goal String
  mode String
  startDate String
  examDate String
  dailyMinutes Int
  status String @default("RUNNING")
  result String @default("")
  sources String @default("[]")
  events String @default("[]")
  error String @default("")
  toolTokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
}


model AiSession {
  id String @id @default(uuid())
  userId String
  title String
  providerId String
  modelId String
  scenario String @default("CONCEPT_EXPLAIN")
  includeContext Boolean @default(false)
  retrievalMode String @default("keyword")
  embeddingProviderId String @default("")
  embeddingModelId String @default("")
  activeRequestId String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, updatedAt])
}
model AiTurn {
  id String @id @default(uuid())
  sessionId String
  userId String
  clientRequestId String
  requestHash String
  status String @default("RUNNING")
  userText String
  assistantText String @default("")
  error String @default("")
  errorCode String @default("")
  sources String @default("[]")
  usage String @default("{}")
  providerId String
  modelId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, clientRequestId])
  @@index([userId, sessionId, createdAt])
}
