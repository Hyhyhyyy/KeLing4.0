# Optional server-only model configuration. Blank means unavailable.
# Never put secrets in VITE_* or Android BuildConfig.
# Use exact model IDs from your provider account, comma separated. No guessed model IDs.
# *_BASE_URL is the API root, without /chat/completions, /messages or ?key=.
# Chat and embedding are separate allowlists. A discovered model is NOT auto-enabled.

# deepseek
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_CHAT_MODELS=
AI_DEEPSEEK_EMBEDDING_MODELS=

# bailian
AI_BAILIAN_API_KEY=
AI_BAILIAN_CHAT_MODELS=
AI_BAILIAN_EMBEDDING_MODELS=

# moonshot
AI_MOONSHOT_API_KEY=
AI_MOONSHOT_CHAT_MODELS=
AI_MOONSHOT_EMBEDDING_MODELS=

# zhipu
AI_ZHIPU_API_KEY=
AI_ZHIPU_CHAT_MODELS=
AI_ZHIPU_EMBEDDING_MODELS=

# siliconflow
AI_SILICONFLOW_API_KEY=
AI_SILICONFLOW_CHAT_MODELS=
AI_SILICONFLOW_EMBEDDING_MODELS=

# ark
AI_ARK_API_KEY=
AI_ARK_CHAT_MODELS=
AI_ARK_EMBEDDING_MODELS=

# hunyuan
AI_HUNYUAN_API_KEY=
AI_HUNYUAN_CHAT_MODELS=
AI_HUNYUAN_EMBEDDING_MODELS=

# huawei — region-specific MaaS HTTPS root required
AI_HUAWEI_API_KEY=
AI_HUAWEI_CHAT_MODELS=
AI_HUAWEI_EMBEDDING_MODELS=
AI_HUAWEI_BASE_URL=

# openai
AI_OPENAI_API_KEY=
AI_OPENAI_CHAT_MODELS=
AI_OPENAI_EMBEDDING_MODELS=

# anthropic
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_CHAT_MODELS=

# gemini
AI_GEMINI_API_KEY=
AI_GEMINI_CHAT_MODELS=
AI_GEMINI_EMBEDDING_MODELS=

# openrouter
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_CHAT_MODELS=
AI_OPENROUTER_EMBEDDING_MODELS=

# ollama
AI_OLLAMA_API_KEY=
AI_OLLAMA_CHAT_MODELS=
AI_OLLAMA_EMBEDDING_MODELS=

# custom
AI_CUSTOM_API_KEY=
AI_CUSTOM_CHAT_MODELS=
AI_CUSTOM_EMBEDDING_MODELS=
AI_CUSTOM_BASE_URL=

# Ollama is disabled until explicitly enabled; default loopback 127.0.0.1:11434/v1.
# In a container loopback means that container; expose Ollama through a private HTTPS endpoint to use another host.
AI_OLLAMA_ENABLED=false
# AI_OPENAI_TOKEN_PARAMETER=max_completion_tokens
# Use max_tokens only when required by your selected compatible service.

# AgentArts planning (separate from chat provider selection)
PLANNING_PROVIDER=auto
AGENTARTS_RUNTIME_URL=
AGENTARTS_API_KEY=
AGENTARTS_TOOL_SECRET=
AGENTARTS_INVOKE_MODE=published
AGENTARTS_RUNTIME_KIND=workflow
