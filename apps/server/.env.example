PORT=3001
NODE_ENV=development
DATABASE_URL=file:./dev.db
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
AGENTARTS_RUNTIME_URL=
AGENTARTS_API_KEY=
AGENTARTS_TOOL_SECRET=
AGENTARTS_INVOKE_MODE=published
# workflow sends inputs; agent also sends query. See docs/MULTIPLATFORM_UPGRADE.md.
AGENTARTS_RUNTIME_KIND=workflow
# auto prefers AgentArts; explicit choices never silently switch providers.
PLANNING_PROVIDER=auto
DEEPSEEK_API_KEY=
