# Copy to .env.deploy. Generate distinct values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
JWT_SECRET=
# Local Compose defaults. For public deployment: real hostname, exact HTTPS origin, BIND_ADDRESS=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443.
SITE_ADDRESS=http://localhost
CORS_ORIGINS=http://localhost:8080
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# Optional AI settings: copy only required AI_* / AGENTARTS_* values from apps/server/.env.ai.example.
